+/// File clients need one complete transcript, not live keyboard output.
+/// Inspect overrides without consuming them; the batch output path owns them.
+fn file_output_requested(config: &Config, pending: Option<&str>) -> bool {
+    match pending.map(str::trim) {
+        Some("file") => true,
+        Some(value) if value.starts_with("file:") => true,
+        Some("type" | "clipboard" | "paste") => false,
+        _ => config.output.mode == OutputMode::File,
     }
 }
 
